---
interface Certificate {
  id: string;
  title: string;
  issuer: string;
  role: string;
  badge?: string;
  badgeColor?: string;
  date: string;
  credentialId?: string;
  image: string;
  description: string;
}

// Urutkan berdasarkan waktu terbaru (Reverse Chronological: 2026 terbaru -> 2025)
const certificates: Certificate[] = [
  {
    id: "jcc-2026",
    title: "Jatim Cybersecurity Competition (JCC) 2026",
    issuer: "Diskominfo Provinsi Jawa Timur",
    role: "Grand Finalist (Top 40 Finalist Teams out of 403 teams / 159 schools across East Java)",
    badge: "Grand Finalist",
    badgeColor: "badge-primary",
    date: "Oktober 2026",
    image: "/certificates/jcc-finalist-cert.webp",
    description: "Lolos babak penyisihan jeopardy sebagai Top 40 Finalis dari total 403 tim se-Jawa Timur, lalu bertanding di babak Grand Final luring di Surabaya dengan format Attack-Defense CTF.",
  },
  {
    id: "code-challenge-telkom-2026",
    title: "Kompetisi Nasional CODE CHALLENGE CTF 2026",
