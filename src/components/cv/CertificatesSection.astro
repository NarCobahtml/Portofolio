    description: "Sertifikat partisipasi aktif dan keterlibatan antusias dalam ajang kompetisi Capture The Flag (CTF): ZERO DAY 2026 cluster pelajar/scholar.",
  },
  {
    id: "cbd-regional-2026",
    title: "Cyber Breaker Development (CBD) Regional — Break The Limit",
    issuer: "Satria Siber Nusantara & Peris.ai",
    role: "Peserta (Team: Sembarang Wes - 2, SiapaHeker)",
    badge: "Cybersecurity Workshop",
    badgeColor: "badge-warning",
    date: "2–3 Mei 2026",
    credentialId: "424/EXT/CBD-REGIONAL/PRS/VIII/2026",
    image: "/certificates/cbd-regional.webp",
    description: "Partisipasi aktif dalam workshop dan kompetisi Cyber Breaker Development Regional yang diadakan oleh Cyber Breaker didukung oleh Satria Siber Nusantara & Peris.ai.",
  },
