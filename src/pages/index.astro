---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Nararya Wirazahran Prasetyo</div>
    <div class="text-3xl py-3 font-bold">Junior Web & Mobile Developer | CTF Enthusiast</div>
    <div class="py-2">
      <text class="text-lg">
        Student at <b>SMKN 4 Malang</b> (Software Engineering) based in East Java, Indonesia. Passionate about building web and mobile applications with <b>TypeScript, Next.js, and Flutter</b>, and actively researching cybersecurity and competing in Capture The Flag (CTF)
      </text>
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/nararya-wirazahran-prasetyo-658929393/" target="_blank"> Let's connect!</a>
      <a href="https://github.com/NarCobahtml" target="_blank" class="btn btn-outline ml-5">
        GitHub Profile
      </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
  </div>

  <HorizontalCard
    title="TanamanKu"
    img="/post_img.webp"
    desc="Modern plant care and environmental awareness web platform built with TypeScript, Next.js, and responsive UI components."
    url="https://tanamanku.web.id"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SwaraNusa — Cultural Web & Mobile Platform"
    img="/post_img.webp"
    desc="A digital initiative to preserve Indonesian traditional musical instruments featuring an interactive web portal and a Flutter quiz mobile application."
    url="https://narcobahtml.github.io/SwaraNusa-Web-Project/"
    badge="FEATURED"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="CTF Writeups & Security Research"
    img="/post_img.webp"
    desc="Curated collection of cybersecurity writeups and exploit scripts across CyLab Academy, TryHackMe, and picoCTF covering Web, Pwn, Crypto, and Forensics."
    url="https://github.com/NarCobahtml/CTF-Writeups"
    badge="CYBERSEC"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
  </div>

  {
    last_posts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
