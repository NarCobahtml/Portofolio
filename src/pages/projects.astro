---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Web & Mobile Applications</div>
  </div>

  <HorizontalCard
    title="TanamanKu"
    img="/projects/tanamanku.webp"
    desc="A modern web platform dedicated to plant care and gardening guidance, built with TypeScript, Next.js, and clean responsive UI components."
    url="https://tanamanku.web.id"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SwaraNusa Web Portal"
    img="/projects/swaranusa-web.webp"
    desc="Multi-page interactive web application celebrating Indonesian traditional musical instruments with informative guides and audio previews."
    url="https://narcobahtml.github.io/SwaraNusa-Web-Project/"
    badge="OPEN SOURCE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SwaraNusa Mobile Quiz (Flutter)"
    img="/projects/swaranusa-quiz.webp"
    desc="Cross-platform mobile quiz app with 3 game modes (sound guessing, image guessing, history learning) built using Flutter & Dart."
    url="https://github.com/NarCobahtml/FLutter-Mobile-Project"
    badge="MOBILE"
  />

  
</BaseLayout>
