---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title = "Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">Web & Mobile Applications</div>
  </div>

  <HorizontalCard
    title="TanamanKu"
    img="/post_img.webp"
    desc="A modern web platform dedicated to plant care and gardening guidance, built with TypeScript, Next.js, and clean responsive UI components."
    url="https://tanamanku.web.id"
    badge="LIVE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SwaraNusa Web Portal"
    img="/post_img.webp"
    desc="Multi-page interactive web application celebrating Indonesian traditional musical instruments with informative guides and audio previews."
    url="https://narcobahtml.github.io/SwaraNusa-Web-Project/"
    badge="OPEN SOURCE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="SwaraNusa Mobile Quiz (Flutter)"
    img="/post_img.webp"
    desc="Cross-platform mobile quiz app with 3 game modes (sound guessing, image guessing, history learning) built using Flutter & Dart."
    url="https://github.com/NarCobahtml/FLutter-Mobile-Project"
    badge="MOBILE"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Cybersecurity & CTF Research</div>
  </div>

  <HorizontalCard
    title="CTF Writeups & Security Analysis"
    img="/post_img.webp"
    desc="Documented writeups covering Web Exploitation, Reverse Engineering, Binary Exploitation (PIE, stack), Cryptography, Forensics, and OSINT."
    url="https://github.com/NarCobahtml/CTF-Writeups"
    badge="WRITEUPS"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="CyLab Security Academy Profile (SiapaHeker)"
    img="/post_img.webp"
    desc="124+ challenges solved across Web Exploitation (35), General Skills (33), Reverse Engineering (19), Forensics (15), Crypto (11), Pwn (6), and AI (4)."
    url="https://learn.cylabacademy.org/users/SiapaHeker"
    badge="124 SOLVED"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="TryHackMe Security Labs (SiapaHeker)"
    img="/post_img.webp"
    desc="Hands-on penetration testing and room walkthroughs including TakeOver (virtual host fuzzing, SSL SAN discovery) and Compiled (binary reverse engineering)."
    url="https://tryhackme.com/p/SiapaHeker"
    badge="ROOMS"
  />
</BaseLayout>
